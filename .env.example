# NAVIAR CONSULT — Environment Configuration
# Copy this file to .env and fill in the actual values

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Server
PORT=3000
HOST=localhost

# Database
DATABASE_URL=postgresql://naviar_user:password@localhost:5432/naviar
DB_DEBUG=false

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=your-session-secret-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# OAuth (Optional - for future integrations)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# File Storage
STORAGE_TYPE=local
# If using S3:
AWS_REGION=eu-west-1
AWS_BUCKET=naviar-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Configuration
EMAIL_FROM=noreply@naviar.no
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
RESEND_API_KEY=

# Feature Flags
ENABLE_STRIPE=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
