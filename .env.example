# NAVIAR CONSULT - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/naviar_consult
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=naviar_consult

# JWT Authentication
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here
JWT_REFRESH_SECRET=your_very_long_and_secure_refresh_token_secret
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,https://naviar-consult.no

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@naviar-consult.no

# Stripe Payment Integration
STRIPE_PUBLIC_KEY=pk_live_your_public_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Calendly Integration
ENABLE_CALENDLY=true
CALENDLY_API_KEY=your_calendly_api_key

# Whereby Integration (Video Conferencing)
ENABLE_WHEREBY=true
WHEREBY_API_KEY=your_whereby_api_key
WHEREBY_BASE_URL=https://api.whereby.com

# SAP SuccessFactors Integration
ENABLE_SAP_SF=true
SAP_SF_API_KEY=your_sap_sf_api_key
SAP_SF_BASE_URL=https://api.sap.com/successfactors
SAP_SF_COMPANY_ID=naviar

# Visma Integration (Norwegian Accounting)
ENABLE_VISMA=true
VISMA_API_KEY=your_visma_api_key
VISMA_BASE_URL=https://api.visma.com/eaccounting

# Encryption Configuration
ENCRYPTION_KEY=your_32_character_encryption_key_for_aes256
ENCRYPTION_ALGORITHM=aes-256-cbc
ENCRYPTION_IV=your_16_character_initialization_vector

# Document Storage
DOCUMENTS_STORAGE_PATH=/uploads/documents
MAX_DOCUMENT_SIZE=104857600

# File Upload Configuration
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,txt

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Session Configuration
SESSION_SECRET=your_session_secret_key
SESSION_TIMEOUT=1800000

# Rate Limiting
RATE_LIMIT_WINDOW=3600000
RATE_LIMIT_MAX_REQUESTS=1000

# Analytics and Reporting
ANALYTICS_RETENTION_DAYS=90
AGGREGATED_DATA_ANONYMIZATION=true

# Feature Flags
FEATURE_VIDEO_CONSULTATIONS=true
FEATURE_DOCUMENT_ENCRYPTION=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MULTI_LANGUAGE=true

# Security
HTTPS_ONLY=true
SECURE_COOKIES=true
CSRF_PROTECTION=true
HELMET_ENABLED=true

# Norwegian Requirements
COMPANY_BUSINESS_NUMBER=
COMPANY_VAT_NUMBER=
COMPANY_NAME=NAVIAR CONSULT AS

# Timezone
TZ=Europe/Oslo

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_URL=

# Monitoring and Alerting
SENTRY_DSN=
DATADOG_API_KEY=
ALERT_EMAIL=ops@naviar-consult.no

# Development Configuration (not for production)
DEBUG=false
MOCK_EXTERNAL_APIS=false
BYPASS_AUTHENTICATION=false
